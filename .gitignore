# .gitignore

# Dependencies
# This folder contains all the downloaded packages and can be very large.
# It should always be regenerated by running `npm install`.
/node_modules

# Environment Variables
# This file contains secret keys, passwords, and API tokens.
# NEVER commit this file to version control for security reasons.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
# Log files are generated during execution and are not part of the source code.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System Files
# These are system-specific files that have no place in a shared repository.
.DS_Store
Thumbs.db

# IDE and Editor Directories
# User-specific settings for code editors.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Build Output
# If you were compiling code (e.g., TypeScript), you would ignore the output directory.
/dist
/build

# Railway
.railway

# Production files
*.production.log

# Package manager locks (keep package-lock.json for reproducible builds)
# yarn.lock
# pnpm-lock.yaml