# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!
#
# SECURITY WARNING:
# - All secrets in this file are placeholders
# - Generate strong random values for production
# - Rotate credentials regularly
# - Use a secrets manager in production (Azure Key Vault, AWS Secrets Manager, etc.)

# --- Node Environment ---
# Set to 'development' for local testing and 'production' on Railway/production servers
NODE_ENV=production

# Server Configuration
PORT=3000

# --- Session Configuration ---
# CRITICAL: Generate a strong random secret for production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-64-character-random-hex-string-here

# Database Configuration (if using MySQL for sessions)
# DB_HOST=your-database-host
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DB_DATABASE=your-database-name
# DB_PORT=3306

# --- Cequens SMS API Configuration ---
# Get these from your Cequens dashboard
CEQUENS_API_KEY=your-cequens-api-key
CEQUENS_USERNAME=your-cequens-username
CEQUENS_SENDER_NAME=DR.WEEE

# --- Microsoft Dataverse Configuration ---
# Get these from Azure Portal > App Registrations
DATAVERSE_URL=https://your-org.crm.dynamics.com
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- Power Automate Configuration ---
POWER_AUTOMATE_GET_URL=your-power-automate-webhook-url

# --- Azure Maps Configuration ---
# Get from Azure Portal > Azure Maps resource > Authentication
AZURE_MAPS_KEY=your-azure-maps-api-key

# --- Azure Translator API ---
# Get from Azure Portal > Translator resource > Keys and Endpoint
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=your-azure-region

# --- Optional: Frontend URL for CORS ---
# Set to your production domain to restrict CORS
# FRONTEND_URL=https://your-production-domain.com

# Redis Configuration (Optional - for session persistence)
# REDIS_URL=redis://default:password@host:port
