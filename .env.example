# Node Environment
NODE_ENV=production

# Server Configuration
PORT=3000

# Session Configuration
SESSION_SECRET=your-strong-random-secret-here-change-this-in-production

# Database Configuration (if using MySQL)
# DB_HOST=your-database-host
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DB_DATABASE=your-database-name
# DB_PORT=3306

# Cequens SMS API Configuration
CEQUENS_API_KEY=your-cequens-api-key
CEQUENS_USERNAME=your-cequens-username
CEQUENS_SENDER_NAME=DR.WEEE

# Microsoft Dataverse Configuration
DATAVERSE_URL=https://your-org.crm.dynamics.com
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Power Automate Configuration
POWER_AUTOMATE_GET_URL=your-power-automate-webhook-url

# Azure Maps Configuration
AZURE_MAPS_KEY=your-azure-maps-api-key

# Redis Configuration (Optional - for session persistence)
# REDIS_URL=redis://default:password@host:port
